diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_base.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_base.glsl
index 2e0e23bc..3b4ab610 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_base.glsl
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_base.glsl
@@ -94,12 +94,15 @@ layout (binding = 7) readonly buffer SP {int32_t data_sparse[];};
 
 #include "fa_types.glsl"
 
+// The output accumulator holds the unnormalised sum of P*V, which reaches about n_kv * |mean(V)| when attention is spread
+// evenly over a long KV (e.g. a few queries over tens of thousands of keys): far past f16's 65504. So it follows ACC_TYPE,
+// which is f32 unless f16 accumulation was allowed (GGML_PREC_F32 must give f32 here, as it does for S and L).
 #if defined(BFLOAT16)
 #define O_TYPE float
 #define O_TYPEV4 vec4
 #else
-#define O_TYPE FLOAT_TYPE
-#define O_TYPEV4 FLOAT_TYPEV4
+#define O_TYPE ACC_TYPE
+#define O_TYPEV4 ACC_TYPEV4
 #endif
 
 // These can't be `const` globals because GLSL forbids function calls in global
